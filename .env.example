# =====================================================================
# TIC para Unidades Educativas Seguras — variables de entorno de ejemplo
# Copie este archivo como .env y complete los valores. NUNCA suba .env a Git.
# =====================================================================

APP_NAME="TIC Unidades Educativas Seguras"
APP_ENV=local
APP_KEY=
# En producción: APP_DEBUG=false (obligatorio)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guayaquil

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción: LOG_LEVEL=warning
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# PostgreSQL (obligatorio)
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tic_ues
DB_USERNAME=tic_ues
DB_PASSWORD=
DB_SCHEMA=public
# En producción con conexión remota use: DB_SSLMODE=require
DB_SSLMODE=prefer

# ---------------------------------------------------------------------
# Sesiones seguras
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Adjuntos y evidencias SIEMPRE en disco privado (storage/app/private)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Caché en archivos: funciona incluso antes de crear las tablas
CACHE_STORE=file

# ---------------------------------------------------------------------
# Correo (opcional). Mientras MAIL_MAILER=log los correos solo se
# escriben en storage/logs y NO se envían.
# ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Parámetros propios del sistema (config/seguridad_escolar.php)
# ---------------------------------------------------------------------
INSTITUCION_NOMBRE="Unidad Educativa Cardenal Richard Cushing"
INSTITUCION_SIGLAS=UECRC
# URL pública HTTPS definitiva que codificará el QR. Déjela vacía hasta
# tener el dominio publicado: con localhost el QR NO funciona en otros teléfonos.
QR_URL_PUBLICA=
# Destino del QR: "bienvenida" o "formulario"
QR_DESTINO=bienvenida
# Habilita el formulario público (sin sesión) si el flujo institucional lo aprueba
REPORTES_PUBLICOS_HABILITADOS=true
# Máximo de reportes públicos por IP y por hora
REPORTES_PUBLICOS_LIMITE_HORA=5
# Adjuntos: tamaño máximo en KB y cantidad por envío
ADJUNTOS_MAX_KB=5120
ADJUNTOS_MAX_ARCHIVOS=3
# Intentos de inicio de sesión antes de bloquear temporalmente
LOGIN_MAX_INTENTOS=5
# Registrar IP en la bitácora (true/false) — requiere justificación institucional
AUDITORIA_REGISTRAR_IP=true
# Contraseña para usuarios de DEMOSTRACIÓN (solo APP_ENV=local). Si queda
# vacía, el seeder genera contraseñas aleatorias y las muestra una sola vez.
DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
